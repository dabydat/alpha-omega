<!-- Full Error Page Template -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Error</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 40px; text-align: center; background: #f5f5f5; }
    .error-container { border: 1px solid #dc3545; padding: 30px; border-radius: 5px; background: white; max-width: 500px; margin: 50px auto; }
    .error-icon { font-size: 48px; color: #dc3545; margin-bottom: 20px; }
    .error-title { color: #dc3545; font-size: 24px; margin: 0 0 15px 0; }
    .error-message { color: #666; font-size: 16px; margin: 0 0 20px 0; }
    .error-actions a { color: #007bff; text-decoration: none; margin: 0 10px; }
    .error-actions a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="error-container">
    <div class="error-icon">!</div>
    <h1 class="error-title">Error</h1>
    <p class="error-message">{{message}}</p>
    <div class="error-actions">
      <a href="/">Back to home</a>
      <a href="/help">Get help</a>
    </div>
  </div>
</body>
</html>
